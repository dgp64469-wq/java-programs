package array_based_questions;
import java.util.Scanner;
public class Odd {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int arr[] = new int[n];
		for(int i = 0; i < n; i++) {
			arr[i] = sc.nextInt();
		}
		for(int i = 0; i < n; i++) {
			if((arr[i]&1) == 1) {
			System.out.println(arr[i]);
		}

	}

}
}
