import java.io.*;
import java.util.*;

public class Solution {
    static int isSufficient (int r, int unit, int n, int arr[]){
        if(n == 0)return -1;
        int s = r * unit;
        int sum = 0;
        for(int i = 0 ; i < n; i++){
            sum += arr[i];
            if(sum >= s){
                return i+1;
            }
        }
        return 0;
    }

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner sc = new Scanner(System.in);
        int r = sc.nextInt();
        int unit = sc.nextInt();
        int n = sc.nextInt();
        int arr[] = new int[n];
        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        System.out.println(isSufficient(r, unit, n, arr));
    }
}
